# ---------------------------------------------------------------------------
# Optional configuration for the contact form.
#
# Leave both values empty to use the mailto fallback: the form validates your
# input and opens a pre-filled message in the visitor's own email app.
# Nothing is silently "sent", and no success message is faked.
#
# To receive messages directly from the site, create a free form endpoint
# (Formspree, Web3Forms, Basin, Getform, or your own API) and paste the URL:
#
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
#
# Rebuild and redeploy after changing these values on Netlify.
# ---------------------------------------------------------------------------
VITE_CONTACT_ENDPOINT=
